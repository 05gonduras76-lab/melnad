<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:maxHeight="650dp">

    <View
        android:id="@+id/settingsGlassBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_context_menu_dark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Р—Р°РіРѕР»РѕРІРѕРє Рё РєР°СЂС‚РѕС‡РєР° ArLauncher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/launcher_subtitle"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- РЎРµРєС†РёСЏ: РћС„РѕСЂРјР»РµРЅРёРµ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/section_appearance"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="12dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchRealtimeBlur"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/setting_blur"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDarkGlass"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/setting_dark_glass"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchClockWidget"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/setting_clock_widget"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnPickWidget"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_search_dark"
                    android:gravity="center"
                    android:text="@string/setting_pick_widget"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setting_dock_style"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerDockStyle"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="#FFFFFFFF" />
            </LinearLayout>

            <!-- РЎРµРєС†РёСЏ: РРєРѕРЅРєРё -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/section_icons"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="12dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchHideLabels"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/setting_hide_labels"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMonochrome"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/setting_monochrome"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvIconSizeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekIconSize"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:max="28"
                    android:progress="12" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/setting_icon_shape"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerIconShape"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="#FFFFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/setting_icon_design"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerIconDesign"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="#FFFFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/setting_icon_tint"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/tintNone"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_margin="5dp"
                        android:background="@drawable/dot_active" />

                    <View
                        android:id="@+id/tintCyan"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_margin="5dp"
                        android:background="#64D2FF" />

                    <View
                        android:id="@+id/tintGold"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_margin="5dp"
                        android:background="#FFD60A" />

                    <View
                        android:id="@+id/tintRose"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_margin="5dp"
                        android:background="#FF375F" />

                    <View
                        android:id="@+id/tintViolet"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_margin="5dp"
                        android:background="#BF5AF2" />
                </LinearLayout>
            </LinearLayout>

            <!-- РЎРµРєС†РёСЏ: РђРЅРёРјР°С†РёРё -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/section_animations"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_anim_style"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerAnimStyle"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/tvAnimSpeedLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekAnimSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:max="400"
                    android:progress="180" />

                <TextView
                    android:id="@+id/tvAnimBlurLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekAnimBlur"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:max="45"
                    android:progress="28" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCloseSettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_search_dark"
                android:gravity="center"
                android:text="@string/close"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>