<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:maxHeight="620dp">

    <View
        android:id="@+id/settingsGlassBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_context_menu_dark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/settings_title"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchRealtimeBlur"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/setting_blur"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDarkGlass"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/setting_dark_glass"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchHideLabels"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/setting_hide_labels"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchMonochrome"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/setting_monochrome"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchClockWidget"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/setting_clock_widget"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnPickWidget"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_search_dark"
                android:gravity="center"
                android:text="@string/setting_pick_widget"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvIconSizeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekIconSize"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:max="28"
                android:progress="12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/setting_icon_shape"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerIconShape"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#FFFFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/setting_icon_design"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerIconDesign"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#FFFFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/setting_dock_style"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerDockStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#FFFFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/setting_icon_tint"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/tintNone"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/dot_active" />

                <View
                    android:id="@+id/tintCyan"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:background="#64D2FF" />

                <View
                    android:id="@+id/tintGold"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:background="#FFD60A" />

                <View
                    android:id="@+id/tintRose"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:background="#FF375F" />

                <View
                    android:id="@+id/tintViolet"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:background="#BF5AF2" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCloseSettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_dark"
                android:gravity="center"
                android:text="@string/close"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>